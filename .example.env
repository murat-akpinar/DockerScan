# ============================================
# DockScan - Environment Configuration
# ============================================

FRONTEND_PORT=3017
BACKEND_PORT=3018
EXPORT_DIR=./export
TZ=Europe/Istanbul

# Frontend build-time API URL
# Boş bırakılırsa nginx proxy üzerinden çalışır (önerilen).
# Farklı bir sunucudan erişiyorsan nginx portunu yaz:
# VITE_API_BASE=http://192.168.1.x:3017
VITE_API_BASE=

# Backend CORS — sadece VITE_API_BASE dolu olduğunda gerekli.
# ALLOWED_ORIGINS=http://192.168.1.x:3017
