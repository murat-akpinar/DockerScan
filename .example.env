# ============================================
# DockScan - Environment Configuration
# ============================================

FRONTEND_PORT=3017
BACKEND_PORT=3018
EXPORT_DIR=./export
TZ=Europe/Istanbul

# Frontend build-time API URL — backend portu (BACKEND_PORT)
# IP ile erişiyorsan makinenin IP'sini yaz:
VITE_API_BASE=http://192.168.1.x:3018

# Backend'in kabul edeceği CORS origin — frontend'in adresi
ALLOWED_ORIGINS=http://192.168.1.x:3017
